{
  "name": "videotex-ui",
  "version": "0.1.0",
  "description": "React UI kit inspired by French Videotex: 40 \u00d7 25 grid, mosaic graphics, 8 colours, function keys.",
  "keywords": [
    "react",
    "minitel",
    "videotex",
    "teletext",
    "retro",
    "ui-kit",
    "shadcn",
    "mosaic"
  ],
  "homepage": "https://github.com/Gleaming0427/videotex-ui#readme",
  "bugs": {
    "url": "https://github.com/Gleaming0427/videotex-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gleaming0427/videotex-ui.git"
  },
  "license": "MIT",
  "author": "Julien Chapron",
  "type": "module",
  "files": [
    "dist",
    "r",
    "CHANGELOG.md"
  ],
  "main": "./dist/videotex-ui.js",
  "module": "./dist/videotex-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/videotex-ui.js"
    },
    "./styles.css": "./dist/videotex-ui.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "record": "npm run build:demo && node scripts/record-demo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "registry": "node scripts/registry.mjs",
    "registry:check": "node scripts/registry.mjs --check",
    "registry:build": "shadcn build registry.json --output r",
    "prepack": "npm run build && npm run registry:check && npm run registry:build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@fontsource/vt323": "5.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "puppeteer-core": "25.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
